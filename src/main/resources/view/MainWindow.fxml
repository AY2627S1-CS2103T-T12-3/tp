<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<fx:root type="javafx.stage.Stage" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
         title="InternTrack" minWidth="1000" minHeight="650" onCloseRequest="#handleExit">
  <icons>
    <Image url="@/images/address_book_32.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@DarkTheme.css" />
        <URL value="@Extensions.css" />
        <URL value="@WorkspaceTheme.css" />
      </stylesheets>

      <VBox styleClass="app-root">
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="app-header" VBox.vgrow="NEVER">
          <StackPane styleClass="brand-mark">
            <SVGPath content="M3 6h10v8H3z M5 6V4h6v2 M3 9h10 M7 9v2h2V9"
                     scaleX="2" scaleY="2" styleClass="brand-mark-icon" />
          </StackPane>
          <VBox spacing="1">
            <Label text="InternTrack" styleClass="brand-title" />
            <Label text="CONTACTS &amp; APPLICATIONS" styleClass="brand-subtitle" />
          </VBox>
          <Pane HBox.hgrow="ALWAYS" />
          <Button mnemonicParsing="false" onAction="#handleHelp" text="Help" styleClass="header-help-button" />
          <padding>
            <Insets top="12" right="28" bottom="12" left="28" />
          </padding>
        </HBox>

        <HBox spacing="24" styleClass="app-body" VBox.vgrow="ALWAYS">
          <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                      styleClass="workspace-sidebar" HBox.hgrow="NEVER">
            <content>
              <VBox spacing="8" styleClass="workspace-sidebar-content">
                <Label text="WORKSPACE" styleClass="sidebar-section-title" />
                <Button fx:id="overviewButton" mnemonicParsing="false" onAction="#showOverview" text="Overview"
                        styleClass="navigation-button" />
                <Button fx:id="applicationsButton" mnemonicParsing="false" onAction="#showApplications"
                        text="Applications" styleClass="navigation-button" />
                <Button fx:id="contactsButton" mnemonicParsing="false" onAction="#showContacts" text="Contacts"
                        styleClass="navigation-button" />
                <Button fx:id="calendarButton" mnemonicParsing="false" onAction="#showApplicationCalendar"
                        text="Calendar" styleClass="navigation-button" />
                <Pane VBox.vgrow="ALWAYS" />
                <Label text="QUICK COMMANDS" styleClass="sidebar-section-title" />
                <Button mnemonicParsing="false" onAction="#prepareApplicationCreation"
                        text="addapp&#10;Create an application" styleClass="quick-command-button" />
                <Button mnemonicParsing="false" onAction="#prepareContactCreation" text="add&#10;Save a new contact"
                        styleClass="quick-command-button" />
                <Button mnemonicParsing="false" onAction="#prepareContactSearch" text="find&#10;Search contacts"
                        styleClass="quick-command-button" />
                <Label text="Need help? Select Help in the top-right corner to view all commands."
                       wrapText="true"
                       styleClass="sidebar-tip" />
                <padding>
                  <Insets top="24" right="18" bottom="20" left="18" />
                </padding>
              </VBox>
            </content>
          </ScrollPane>

          <VBox spacing="14" styleClass="workspace-content" HBox.hgrow="ALWAYS">
            <VBox fx:id="commandPanel" spacing="7" styleClass="command-panel" VBox.vgrow="NEVER">
              <Label text="COMMAND BOX" styleClass="command-panel-title" />
              <StackPane fx:id="commandBoxPlaceholder" />
              <StackPane fx:id="resultDisplayPlaceholder" minHeight="25" prefHeight="25" maxHeight="25" />
              <padding>
                <Insets top="15" right="20" bottom="15" left="20" />
              </padding>
            </VBox>
            <StackPane fx:id="personListPanelPlaceholder" VBox.vgrow="ALWAYS" />
            <StackPane fx:id="statusbarPlaceholder" VBox.vgrow="NEVER" />
          </VBox>
          <padding>
            <Insets top="20" right="24" bottom="20" left="24" />
          </padding>
        </HBox>
      </VBox>
    </Scene>
  </scene>
</fx:root>
