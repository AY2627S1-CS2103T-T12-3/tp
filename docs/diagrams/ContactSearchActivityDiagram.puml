@startuml
!include style.puml

title Contact search matching

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor MODEL_COLOR
    FontColor #222222
    DiamondBackgroundColor #FFFFFF
    DiamondBorderColor MODEL_COLOR
}
skinparam ArrowColor MODEL_COLOR
skinparam ArrowFontColor #222222

start
:Receive a contact and search keywords;
:Check all keywords against name, phone, email, company, role,\nwhere met, address, remark, and tags using case-insensitive,\nfull-word matching;
if (Does any keyword match any field?) then (yes)
    :Include contact in filtered results;
else (no)
    :Exclude contact from filtered results;
endif
stop
@enduml
