@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as logic LOGIC_COLOR
participant "command:Command" as command LOGIC_COLOR
end box
box Model MODEL_COLOR_T1
participant "model:Model" as model MODEL_COLOR
end box
box Storage STORAGE_COLOR_T1
participant "storage:Storage" as storage STORAGE_COLOR
end box

[-> logic : execute(commandText)
activate logic
logic -> logic : parse commandText
note right: The remaining flow shows a valid command.
logic -> model : getAddressBook()
model --> logic : current records
logic -> logic : beforeCommand = new AddressBook(records)
logic -> command : execute(model)
activate command
command --> logic : commandResult
deactivate command
logic -> model : getAddressBook()
model --> logic : current records
alt records unchanged
    [<-- logic : commandResult
else records changed
    logic -> storage : saveAddressBook(records)
    alt save succeeds
        storage --> logic : success
        [<-- logic : commandResult
    else IOException
        storage --> logic : throws IOException
        logic -> model : setAddressBook(beforeCommand)
        model --> logic
        [<-- logic : throws CommandException
    end
end
deactivate logic
note over logic, model
Rollback restores records, not the contact filter or other UI state.
end note
@enduml
