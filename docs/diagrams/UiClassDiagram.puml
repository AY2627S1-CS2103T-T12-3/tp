@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam class<<VBox>> {
    BackgroundColor #FFFFFF
    BorderColor UI_COLOR
    FontColor UI_COLOR
}

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class CommandBox
Class StatusBarFooter
Class PersonListPanel
Class PersonCard
Class ApplicationListPanel
Class ApplicationCard
Class DashboardPanel <<VBox>>
Class ApplicationCalendarPanel <<VBox>>
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .up.|> Ui
UiManager -down-> "1" MainWindow
UiManager -right-> Logic
MainWindow -right-> Logic

MainWindow *-down-> "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" StatusBarFooter
MainWindow -down-> "1" HelpWindow
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" ApplicationListPanel
MainWindow *-down-> "1" ApplicationCalendarPanel
MainWindow *-down-> "1" DashboardPanel

PersonListPanel -down-> "*" PersonCard
ApplicationListPanel -down-> "*" ApplicationCard


HelpWindow -[hidden]right- ResultDisplay
ResultDisplay -[hidden]right- CommandBox
CommandBox -[hidden]right- StatusBarFooter
StatusBarFooter -[hidden]right- PersonListPanel
PersonListPanel -[hidden]right- ApplicationListPanel
ApplicationListPanel -[hidden]right- ApplicationCalendarPanel
ApplicationCalendarPanel -[hidden]right- DashboardPanel

PersonCard ..> Model
ApplicationCard ..> Model
ApplicationCalendarPanel ..> Model
DashboardPanel ..> Model

legend bottom right
MainWindow and the green parts below it extend UiPart.
White boxes extend JavaFX VBox directly.
end legend
@enduml
