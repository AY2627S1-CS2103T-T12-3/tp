@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package "Model" as ModelPackage <<Rectangle>> {
    interface ReadOnlyAddressBook
    interface ReadOnlyUserPrefs
    interface Model

    class AddressBook
    class ModelManager
    class UserPrefs

    class UniquePersonList
    class Person
    class Name
    class Phone
    class Email
    class Address
    class Company
    class Role
    class WhereMet
    class Remark
    class Tag

    class UniqueApplicationList
    class Application
    class ApplicationName
    class ApplicationDate
    class Description
    enum ApplicationStatus {
        APPLIED
        INTERVIEWING
        OFFERED
        REJECTED
        WITHDRAWN
    }
}

AddressBook ..|> ReadOnlyAddressBook
ModelManager ..|> Model
UserPrefs ..|> ReadOnlyUserPrefs

Model ..> ReadOnlyAddressBook
Model ..> ReadOnlyUserPrefs
ModelManager *--> "1" AddressBook
ModelManager *--> "1" UserPrefs
ModelManager --> "0..* filtered" Person

AddressBook *--> "1" UniquePersonList
AddressBook *--> "1" UniqueApplicationList
UniquePersonList --> "0..*" Person
UniqueApplicationList --> "0..*" Application

Person *--> "1" Name
Person *--> "1" Phone
Person *--> "1" Email
Person *--> "1" Address
Person *--> "0..1" Company
Person *--> "0..1" Role
Person *--> "0..1" WhereMet
Person *--> "1" Remark
Person *--> "0..*" Tag

Application *--> "1" ApplicationName
Application *--> "1" Company
Application *--> "1" Description
Application *--> "1" ApplicationDate
Application --> "1" ApplicationStatus : status
@enduml
